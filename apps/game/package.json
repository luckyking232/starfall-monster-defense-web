{
  "name": "starfall-monster-defense-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:inputs": "node scripts/check_local_inputs.mjs",
    "prebuild": "npm run check:inputs",
    "build": "npm run typecheck && vite build && node scripts/build_engine_api.mjs && node scripts/build_fgui_probe.mjs && node scripts/build_ui_host.mjs",
    "test:unit": "vitest run tests/unit",
    "test:inputs": "node --test tests/check-local-inputs.test.mjs",
    "test:content": "node scripts/run_content_tests.mjs",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:inputs && npm run test:e2e",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
