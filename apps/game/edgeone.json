{
  "buildCommand": "npm run build && node scripts/hosted-release.mjs retain dist https://fallstar.online/",
  "headers": [
    {
      "source": "/version.json",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/asset-inventory.json",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/assets/release-*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ]
}
